# URL base de la API de backend-go (copiar como .env y ajustar).
# Expo solo expone a la app variables que empiezan con EXPO_PUBLIC_.
#
# Teléfono físico con Expo Go (misma red Wi-Fi que el computador):
#   usar la IP local del computador, ej. http://192.168.1.20:3001/api/v1
# Emulador Android:  http://10.0.2.2:3001/api/v1
# Simulador iOS:     http://localhost:3001/api/v1
# Cluster:           https://api-backend-tpenroz.dev.censei.cl/api/v1
EXPO_PUBLIC_API_URL=http://192.168.1.20:3001/api/v1

# WebSocket del mapa en tiempo real. Opcional: por defecto se deduce de la URL de
# la API (https://host/api/v1 -> wss://host/ws).
# EXPO_PUBLIC_WS_URL=wss://api-backend-tpenroz.dev.censei.cl/ws

# Radio (m) alrededor de un paradero oficial dentro del cual se considera que el
# usuario está en el paradero y se permiten alertas de proximidad (por defecto 100).
EXPO_PUBLIC_STOP_RADIUS_M=100
# Precisión máxima aceptable del GPS (m) para confirmar la cercanía (por defecto 100).
EXPO_PUBLIC_MAX_LOCATION_ACCURACY_M=100
# Radio (m) alrededor del paradero en que una micro que se acerca genera alerta (por defecto 500).
EXPO_PUBLIC_ALERT_RADIUS_M=500
