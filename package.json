{
  "name": "transporte-publico-urbano",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma integral de monitoreo y gestión del transporte público urbano",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:go\" \"npm run dev:frontend\"",
    "dev:go": "cd backend-go && go run ./cmd/server",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev:go",
    "dev:backend:ts": "npm run dev --workspace=backend",
    "build": "npm run build --workspaces",
    "install:all": "npm install",
    "db:generate": "npm run db:generate --workspace=backend",
    "db:migrate": "npm run db:migrate --workspace=backend",
    "db:seed": "npm run db:seed --workspace=backend",
    "db:studio": "npm run db:studio --workspace=backend",
    "db:reset": "npm run db:reset --workspace=backend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
