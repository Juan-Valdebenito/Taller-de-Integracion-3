# Configuracion local de desarrollo
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/transporte_db
JWT_SECRET=dev_secret_cambiarlo_en_produccion_123
JWT_EXPIRES_IN=7d
# Uno o varios orígenes separados por coma. :8081 = vista previa web de la app
# móvil (npx expo start --web), útil para verla en el navegador de VS Code.
CORS_ORIGIN=http://localhost:5173,http://localhost:8081
NODE_ENV=development

# ── WebSocket (Pub/Sub) ──────────────────────────────────
# Configuración opcional del servidor WebSocket.
# WS_READ_BUFFER=1024
# WS_WRITE_BUFFER=1024
# WS_MAX_MESSAGE_SIZE=4096

# ── Predictor ML (opcional) ───────────────────────────────
# Dejar vacío para usar predictor heurístico por defecto.
# PREDICTION_TRANSPORT=http        # "http" o "grpc"
# PREDICTION_HTTP_URL=http://cluster:8080/predict
# PREDICTION_GRPC_ADDR=cluster:50051
# PREDICTION_TIMEOUT_SEC=5

# ── Simulación GPS ────────────────────────────────────────
# Activa el motor de simulación circular con buses virtuales
# en las rutas 7A, 7B y 1C de Temuco con coordenadas GPS reales.
# Desactivar cuando el cluster ML provea datos reales.
SIMULATION_ENABLED=true
SIMULATION_TICK_MS=2000
SIMULATION_SPEED_MULTIPLIER=3

# ── Rate limiting en /api/v1/auth/* (por IP) ──────────────
# Protege contra DoS y fuerza bruta. Al exceder el límite la API responde
# 429 Too Many Requests con el header Retry-After (segundos).
#   AUTH  → login y registro
#   TOKEN → rotación de tokens: refresh, logout y revoke
# RATE_LIMIT_ENABLED=false solo para pruebas de carga sobre estos endpoints.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_AUTH_BURST=5
RATE_LIMIT_TOKEN_PER_MIN=30
RATE_LIMIT_TOKEN_BURST=10
# Proxies (IPs o CIDR, separados por coma) de los que se acepta X-Forwarded-For.
# Vacío = comportamiento por defecto de Gin. En el cluster, la red del Ingress.
# TRUSTED_PROXIES=10.0.0.0/8

# ── Revocacion dinamica de tokens JWT (RevocationStore) ───
# Vacio = almacen en memoria por proceso (solo sirve con 1 replica).
# Cuando el equipo de cluster despliegue el Redis compartido, setear aqui
# la ruta del Service (ej: redis-svc.student-jvaldebenito.svc.cluster.local:6379)
# para que la revocacion sea consistente entre todos los pods del backend.
# REDIS_ADDR=
# REDIS_PASSWORD=
# REDIS_DB=0
