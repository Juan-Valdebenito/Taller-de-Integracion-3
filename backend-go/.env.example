# ============================================================
# Variables de Entorno - Backend Go
# ============================================================
# Copia este archivo como .env y ajusta los valores.

# ── Servidor ──────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Base de Datos (PostgreSQL) ────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/transporte_db"

# ── JWT ──────────────────────────────────────────────────
JWT_SECRET=dev_secret_cambiarlo_en_produccion_123
JWT_EXPIRES_IN=7d

# ── CORS ─────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ── WebSocket (Pub/Sub) ──────────────────────────────────
# Configuración opcional del servidor WebSocket.
# WS_READ_BUFFER=1024
# WS_WRITE_BUFFER=1024
# WS_MAX_MESSAGE_SIZE=4096

