# ============================================================
# Variables de Entorno - Backend Go
# ============================================================
# Copia este archivo como .env y ajusta los valores.

# ── Servidor ──────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Base de Datos (PostgreSQL) ────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/transporte_db"

# ── JWT ──────────────────────────────────────────────────
JWT_SECRET=dev_secret_cambiarlo_en_produccion_123
JWT_EXPIRES_IN=7d

# ── CORS ─────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ── Predicción ML (microservicio externo) ─────────────────
# Protocolo de comunicación con el servidor de predicción: grpc | http
# Dejar vacío para usar el predictor heurístico local (sin dependencia externa).
PREDICTION_TRANSPORT=http

# Dirección del servidor gRPC (sólo si PREDICTION_TRANSPORT=grpc)
PREDICTION_GRPC_ADDR=localhost:50051

# URL base del servidor HTTP (sólo si PREDICTION_TRANSPORT=http)
PREDICTION_HTTP_URL=http://localhost:8000

# Timeout en segundos para cada llamada al microservicio ML (default: 5)
PREDICTION_TIMEOUT_SEC=5
