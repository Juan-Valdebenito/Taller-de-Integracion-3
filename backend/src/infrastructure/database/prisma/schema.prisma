// ============================================================
// Schema de Prisma - Plataforma Transporte Público Urbano
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────────

enum UserRole {
  PASSENGER
  COMPANY
  ADMIN
}

enum BusStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum ComplaintStatus {
  PENDING
  IN_REVIEW
  RESOLVED
  REJECTED
}

enum ComplaintCategory {
  DELAY
  OVERCROWDING
  DRIVER_BEHAVIOR
  VEHICLE_CONDITION
  ACCESSIBILITY
  OTHER
}

enum TripStatus {
  SCHEDULED    // Programado, aún no ha salido
  IN_PROGRESS  // En curso
  COMPLETED    // Completado
  CANCELLED    // Cancelado
}

// ── Modelos ───────────────────────────────────────────────────

model Company {
  id          String   @id @default(uuid())
  name        String
  rut         String   @unique
  address     String?
  phone       String?
  email       String   @unique
  logoUrl     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  buses       Bus[]
  routes      Route[]
  complaints  Complaint[]

  @@map("companies")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(PASSENGER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  companyId    String?
  company      Company? @relation(fields: [companyId], references: [id])

  complaints   Complaint[]

  @@map("users")
}

model Route {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])

  stops       Stop[]
  buses       Bus[]
  complaints  Complaint[]
  trips       Trip[]

  @@map("routes")
}

model Stop {
  id        String  @id @default(uuid())
  name      String
  latitude  Float
  longitude Float
  order     Int

  routeId   String
  route     Route   @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@map("stops")
}

model Bus {
  id                String    @id @default(uuid())
  patente           String    @unique
  capacity          Int       @default(40)
  currentPassengers Int       @default(0)
  boardings         Int       @default(0)
  alightings        Int       @default(0)
  schoolBoardings   Int       @default(0)
  status            BusStatus @default(INACTIVE)

  // Ubicación en tiempo real (actualizada vía Socket.io)
  lastLatitude      Float?
  lastLongitude     Float?
  lastHeading       Float?
  lastSpeed         Float?
  lastLocationAt    DateTime?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  companyId         String
  company           Company   @relation(fields: [companyId], references: [id])

  routeId           String?
  route             Route?    @relation(fields: [routeId], references: [id])

  complaints        Complaint[]
  trips             Trip[]

  @@map("buses")
}

/// Viaje realizado por una micro en una ruta (del MER: VIAJE)
model Trip {
  id            String     @id @default(uuid())
  departureTime DateTime                         // Hora de salida programada / real
  arrivalTime   DateTime?                        // Hora de llegada (null si aún no terminó)
  status        TripStatus @default(SCHEDULED)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  busId         String
  bus           Bus        @relation(fields: [busId], references: [id])

  routeId       String
  route         Route      @relation(fields: [routeId], references: [id])

  passengerLogs PassengerLog[]
  complaints    Complaint[]

  @@map("trips")
}

/// Registro de pasajeros en un punto del viaje (del MER: REGISTRO_PASAJEROS)
model PassengerLog {
  id          String   @id @default(uuid())
  boardings   Int      @default(0)   // Subidas en este registro
  alightings  Int      @default(0)   // Bajadas en este registro
  isSchool    Boolean  @default(false) // ¿Pasaje escolar?
  locationLat Float?                  // Coordenada GPS donde se registró
  locationLng Float?
  recordedAt  DateTime @default(now()) // Momento exacto del registro

  tripId      String
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@map("passenger_logs")
}

model Complaint {
  id            String            @id @default(uuid())
  title         String
  description   String
  category      ComplaintCategory @default(OTHER)
  rating        Int?
  status        ComplaintStatus   @default(PENDING)
  adminResponse String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  passengerId   String?
  passenger     User?             @relation(fields: [passengerId], references: [id])

  busId         String?
  bus           Bus?              @relation(fields: [busId], references: [id])

  routeId       String?
  route         Route?            @relation(fields: [routeId], references: [id])

  companyId     String?
  company       Company?          @relation(fields: [companyId], references: [id])

  // Viaje específico al que aplica el reclamo (opcional)
  tripId        String?
  trip          Trip?             @relation(fields: [tripId], references: [id])

  @@map("complaints")
}
