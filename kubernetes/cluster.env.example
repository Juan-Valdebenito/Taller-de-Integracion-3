# Configuración del despliegue en el cluster (la lee kubernetes/deploy.sh).
#
# Copiar como kubernetes/cluster.env y ajustar. cluster.env NO se sube a git.
# Aquí NO van contraseñas: el inicio de sesión en el cluster se hace aparte,
# antes de ejecutar el script (ver kubernetes/DEPLOY.md).
#
# El despliegue usa cuatro stacks en tres cuentas del cluster:
#   foundation → student-jvaldebenito: NATS, backend-go y transporte-db
#   micros     → student-tpenroz:      ConfigMap, base de datos y servicio de micros
#   app        → student-tpenroz:      frontend e Ingress principal
#   realtime   → student-iglausser:    clima, telemetría, simulador, realtime e Ingress
# Los stacks micros y app comparten namespace y contexto.

# ── Stack "foundation" ─────────────────────────────────────────
FOUNDATION_NAMESPACE=student-jvaldebenito
# Contexto de kubectl para foundation (opcional). Vacío = contexto activo.
# Útil si en la misma máquina están configuradas las tres cuentas:
#   kubectl config get-contexts
FOUNDATION_KUBE_CONTEXT=

# ── Stack "app" ────────────────────────────────────────────────
APP_NAMESPACE=student-tpenroz
APP_KUBE_CONTEXT=
APP_INGRESS_CLASS=nginx

# ── Stack "realtime" ───────────────────────────────────────────
REALTIME_NAMESPACE=student-iglausser
REALTIME_KUBE_CONTEXT=
REALTIME_INGRESS_CLASS=nginx

# Dominio público de la app. external-dns lo crea solo apuntando a
# proxy.inf.uct.cl (mismo patrón que el Ingress de Tomás).
APP_HOST=backend-tpenroz.dev.censei.cl
API_HOST=api-backend-tpenroz.dev.censei.cl

# external-dns crea este host apuntando a proxy.inf.uct.cl.
REALTIME_HOST=realtime-backend-tpenroz.dev.censei.cl
# IP del pod backend-go en FOUNDATION_NAMESPACE para el bridge del Ingress.
# Debe actualizarse si cambia el pod; consultar: kubectl get pods -o wide.
BACKEND_GO_IP=

# Esquema con el que el navegador abre la página (para CORS). El proxy de la
# universidad termina el HTTPS; si la app solo responde por http, poner http.
APP_SCHEME=https

# Usuario de Docker Hub para las imágenes propias: backend-go, realtime,
# frontend y simulador de clima. Las imágenes de micros ya están publicadas
# en ignaciogsm/*.
DOCKERHUB_USER=
IMAGE_TAG=
BACKEND_GO_IMAGE_TAG=

# Contraseña compartida por redis-server y backend-go. No subir valores reales.
REDIS_PASSWORD=
