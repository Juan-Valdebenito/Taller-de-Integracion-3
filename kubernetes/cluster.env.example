# Configuración del despliegue en el cluster (la lee kubernetes/deploy.sh).
#
# Copiar como kubernetes/cluster.env y ajustar. cluster.env NO se sube a git.
# Aquí NO van contraseñas: el inicio de sesión en el cluster se hace aparte,
# antes de ejecutar el script (ver kubernetes/DEPLOY.md).

# Cuenta del cluster que se usa (cada cuenta tiene su propia cuota de recursos)
CLUSTER_USER=tpenroz

# Namespace de esa cuenta. Patrón del curso: student-<usuario>.
# Verificar el real con:  kubectl config view --minify -o jsonpath='{..namespace}'
NAMESPACE=student-tpenroz

# Dominio público. external-dns lo crea solo apuntando a proxy.inf.uct.cl.
# Mismo patrón que el Ingress de Tomás: backend-<usuario>.dev.censei.cl
APP_HOST=backend-tpenroz.dev.censei.cl

# Esquema con el que el navegador abre la página (para CORS). El proxy de la
# universidad termina el HTTPS; si la app solo responde por http, poner http.
APP_SCHEME=https

# Usuario de Docker Hub donde se publican las imágenes propias
# (backend-go, transithub-realtime, transithub-frontend).
DOCKERHUB_USER=
IMAGE_TAG=v1
